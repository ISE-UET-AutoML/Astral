{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "src/*": ["./src/*"]
    },
    "skipLibCheck": true
  },
  "include": ["src", "lib", "components"]
}
