{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "src/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "target": "ES2020",
    "types": ["vite/client"]
  },
  "include": ["src", "lib", "components"]
}
